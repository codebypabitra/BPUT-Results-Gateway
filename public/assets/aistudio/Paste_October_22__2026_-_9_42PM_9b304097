import React, { useState, useRef } from 'react';
import {
  Upload,
  FileSpreadsheet,
  Users,
  Search,
  Download,
  Printer,
  CheckCircle2,
  AlertTriangle,
  Award,
  Eye,
  FileText,
  StopCircle,
  Play,
  Pause,
  ArrowUpDown,
  Activity,
  Terminal,
  Check,
  RotateCcw,
} from 'lucide-react';
import { BPUT_SESSIONS, BulkStudentResult, classifyBacklogGrade } from '../types/bput';
import { getStudentSummary } from '../services/bputApi';
import { generateBulkClassReportPdf } from '../services/pdfGenerator';

interface BulkResultCheckerProps {
  session: string;
  setSession: (s: string) => void;
  onViewStudentMarks: (rollNo: string, semId: string, sessionName: string) => void;
}

interface AccessLog {
  id: string;
  timestamp: string;
  rollNo: string;
  status: 'PENDING' | 'SUCCESS' | 'BACKLOG' | 'NOT_FOUND' | 'ERROR';
  name?: string;
  sgpa?: number;
  message?: string;
}

export const BulkResultChecker: React.FC<BulkResultCheckerProps> = ({
  session,
  setSession,
  onViewStudentMarks,
}) => {
  const [inputTab, setInputTab] = useState<'range' | 'csv' | 'paste'>('range');
  const [csvFileName, setCsvFileName] = useState<string>('');
  const [extractedRolls, setExtractedRolls] = useState<string[]>([]);

  // Range inputs default
  const [rangeStart, setRangeStart] = useState<string>('2001289001');
  const [rangeEnd, setRangeEnd] = useState<string>('2001289015');

  // Paste input
  const [pastedText, setPastedText] = useState<string>('');

  // Processing & Individual Tracking States
  const [isProcessing, setIsProcessing] = useState<boolean>(false);
  const [isPaused, setIsPaused] = useState<boolean>(false);
  const [activeRoll, setActiveRoll] = useState<string | null>(null);
  const [progressCount, setProgressCount] = useState<number>(0);
  const [totalToProcess, setTotalToProcess] = useState<number>(0);

  // Live Results List
  const [results, setResults] = useState<BulkStudentResult[]>([]);
  const [logs, setLogs] = useState<AccessLog[]>([]);
  const [statusMessage, setStatusMessage] = useState<string | null>(null);
  const [showLiveConsole, setShowLiveConsole] = useState<boolean>(true);

  // Filters & sorting
  const [searchQuery, setSearchQuery] = useState<string>('');
  const [filterStatus, setFilterStatus] = useState<'ALL' | 'PASSED' | 'BACKLOG' | 'NOT_FOUND'>('ALL');
  const [sortBy, setSortBy] = useState<'SGPA_DESC' | 'SGPA_ASC' | 'ROLL_ASC' | 'NAME_ASC'>('SGPA_DESC');
  const [isExportingPdf, setIsExportingPdf] = useState<boolean>(false);
  const [bulkPdfDownloaded, setBulkPdfDownloaded] = useState<boolean>(false);

  // Abort & Pause control refs
  const isStoppedRef = useRef<boolean>(false);
  const isPausedRef = useRef<boolean>(false);
  const fileInputRef = useRef<HTMLInputElement>(null);

  // Handle CSV / TXT upload
  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    setCsvFileName(file.name);
    const reader = new FileReader();
    reader.onload = (event) => {
      const text = event.target?.result as string;
      parseRollNumbersFromText(text);
    };
    reader.readAsText(file);
  };

  const parseRollNumbersFromText = (text: string) => {
    const matches = text.match(/\b\d{10}\b/g) || [];
    const uniqueRolls = Array.from(new Set(matches));
    setExtractedRolls(uniqueRolls);
    if (uniqueRolls.length === 0) {
      setStatusMessage('No valid 10-digit registration numbers found in the file.');
    } else {
      setStatusMessage(`Found ${uniqueRolls.length} registration numbers ready for checking.`);
    }
  };

  // Generate range roll numbers
  const generateRangeRolls = () => {
    const startNum = parseInt(rangeStart.trim(), 10);
    const endNum = parseInt(rangeEnd.trim(), 10);

    if (isNaN(startNum) || isNaN(endNum) || rangeStart.length !== 10 || rangeEnd.length !== 10) {
      setStatusMessage('Please enter valid 10-digit starting and ending registration numbers.');
      return [];
    }

    if (endNum < startNum) {
      setStatusMessage('End registration number must be greater than or equal to start number.');
      return [];
    }

    const count = endNum - startNum + 1;
    if (count > 150) {
      setStatusMessage(`Range of ${count} students is too large. Please limit to at most 150 students per run.`);
      return [];
    }

    const rolls: string[] = [];
    for (let i = startNum; i <= endNum; i++) {
      rolls.push(String(i));
    }
    return rolls;
  };

  // Main Individual Tracking Process
  const handleStartBulkCheck = async () => {
    let targetRolls: string[] = [];

    if (inputTab === 'csv') {
      targetRolls = extractedRolls;
    } else if (inputTab === 'range') {
      targetRolls = generateRangeRolls();
    } else if (inputTab === 'paste') {
      const matches = pastedText.match(/\b\d{10}\b/g) || [];
      targetRolls = Array.from(new Set(matches));
    }

    if (targetRolls.length === 0) {
      setStatusMessage('Please provide at least one valid 10-digit registration number.');
      return;
    }

    if (session === 'default_option' || !session) {
      setStatusMessage('Please select an examination session.');
      return;
    }

    setIsProcessing(true);
    setIsPaused(false);
    isStoppedRef.current = false;
    isPausedRef.current = false;

    setProgressCount(0);
    setTotalToProcess(targetRolls.length);
    setResults([]);
    setLogs([]);
    setStatusMessage(null);

    const CONCURRENCY = 20;
    let nextIndex = 0;
    let processedTotal = 0;

    const worker = async () => {
      while (nextIndex < targetRolls.length && !isStoppedRef.current) {
        while (isPausedRef.current && !isStoppedRef.current) {
          await new Promise((resolve) => setTimeout(resolve, 150));
        }
        if (isStoppedRef.current) break;

        const idx = nextIndex++;
        if (idx >= targetRolls.length) break;

        const roll = targetRolls[idx];
        setActiveRoll(roll);

        const timeStr = new Date().toLocaleTimeString('en-GB');
        const pendingLogId = `log-${roll}-${Date.now()}`;
        setLogs((prev) => [
          {
            id: pendingLogId,
            timestamp: timeStr,
            rollNo: roll,
            status: 'PENDING',
            message: 'Accessing BPUT server...'
          },
          ...prev.slice(0, 35)
        ]);

        try {
          const res = await getStudentSummary(roll, session);
          const data = res.data;

          setResults((prev) => [...prev, data]);
          processedTotal++;
          setProgressCount(processedTotal);

          const extCount = data.externalBacklogsCount || 0;
          const intCount = data.internalBacklogsCount || 0;
          const backlogTypeDetails =
            extCount > 0 && intCount > 0
              ? ` [${extCount} F(EX), ${intCount} F(INT)]`
              : extCount > 0
              ? ` [${extCount} F(EX)]`
              : intCount > 0
              ? ` [${intCount} F(INT)]`
              : '';

          setLogs((prev) =>
            prev.map((l) =>
              l.id === pendingLogId
                ? {
                    ...l,
                    status:
                      data.status === 'PASSED'
                        ? 'SUCCESS'
                        : data.status === 'BACKLOG'
                        ? 'BACKLOG'
                        : 'NOT_FOUND',
                    name: data.studentName !== 'Record Not Found' ? data.studentName : undefined,
                    sgpa: data.sgpa,
                    message:
                      data.status === 'PASSED'
                        ? `Passed • SGPA: ${data.sgpa.toFixed(2)}`
                        : data.status === 'BACKLOG'
                        ? `${data.backlogsCount} Backlog${data.backlogsCount > 1 ? 's' : ''}${backlogTypeDetails} • SGPA: ${data.sgpa.toFixed(2)}`
                        : 'Result record not published for this session'
                  }
                : l
            )
          );
        } catch (err: any) {
          const failedRecord: BulkStudentResult = {
            rollNo: roll,
            studentName: 'Gateway Error',
            collegeName: 'N/A',
            branchName: 'N/A',
            semester: 'N/A',
            semId: '',
            sgpa: 0,
            credits: 0,
            totalSubjects: 0,
            passedSubjects: 0,
            backlogsCount: 0,
            externalBacklogsCount: 0,
            internalBacklogsCount: 0,
            otherBacklogsCount: 0,
            backlogSubjects: [],
            status: 'NOT_FOUND',
            grades: []
          };
          setResults((prev) => [...prev, failedRecord]);
          processedTotal++;
          setProgressCount(processedTotal);

          setLogs((prev) =>
            prev.map((l) =>
              l.id === pendingLogId
                ? {
                    ...l,
                    status: 'ERROR',
                    message: err?.message || 'Server connection error'
                  }
                : l
            )
          );
        }
      }
    };

    const workerThreads = Array.from(
      { length: Math.min(CONCURRENCY, targetRolls.length) },
      () => worker()
    );

    await Promise.all(workerThreads);

    setActiveRoll(null);
    setIsProcessing(false);
    setIsPaused(false);
    if (!isStoppedRef.current) {
      setStatusMessage(`Complete! Successfully processed all ${targetRolls.length} students with high-speed parallel tracking.`);
    }
  };

  const handleStop = () => {
    isStoppedRef.current = true;
    setIsProcessing(false);
    setIsPaused(false);
    setActiveRoll(null);
  };

  const handleTogglePause = () => {
    const nextPaused = !isPaused;
    setIsPaused(nextPaused);
    isPausedRef.current = nextPaused;
  };

  // Generate & Download Class PDF Report
  const handleGenerateBulkPdf = () => {
    if (sortedFilteredResults.length === 0) return;
    try {
      setIsExportingPdf(true);
      generateBulkClassReportPdf(
        sortedFilteredResults,
        session,
        averageSgpa,
        passedRecords.length,
        backlogRecords.length,
        totalClassExtBacklogs,
        totalClassIntBacklogs
      );
      setBulkPdfDownloaded(true);
      setTimeout(() => {
        setIsExportingPdf(false);
      }, 700);
      setTimeout(() => {
        setBulkPdfDownloaded(false);
      }, 3500);
    } catch (err) {
      console.error('Failed to generate bulk PDF:', err);
      setIsExportingPdf(false);
    }
  };

  const handlePrintBulk = () => {
    handleGenerateBulkPdf();
    try {
      window.print();
    } catch {}
  };

  // Download Sample CSV
  const handleDownloadSampleCsv = () => {
    const sampleContent = "registration_number\n2001289001\n2001289002\n2001289003\n2001289004\n2001289005\n";
    const blob = new Blob([sampleContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.setAttribute('download', 'bput_sample_students.csv');
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  // Extract backlog subjects with Code, Name, and Status
  const getBacklogItems = (st: BulkStudentResult): Array<{
    code: string;
    name: string;
    status: string;
    type: string;
    isExternal: boolean;
    isInternal: boolean;
  }> => {
    // 1. If structured backlogDetails exist
    if (st.backlogDetails && st.backlogDetails.length > 0) {
      return st.backlogDetails.map((b) => {
        const classification = classifyBacklogGrade(b.grade, b.subjectTP);
        return {
          code: b.subjectCode,
          name: b.subjectName,
          status: b.grade || classification.displayGrade,
          type: b.backlogType || classification.backlogType,
          isExternal: classification.isExternal,
          isInternal: classification.isInternal,
        };
      });
    }

    // 2. If st.grades is available
    if (st.grades && Array.isArray(st.grades) && st.grades.length > 0) {
      const list: Array<{
        code: string;
        name: string;
        status: string;
        type: string;
        isExternal: boolean;
        isInternal: boolean;
      }> = [];
      st.grades.forEach((g: any) => {
        const tp = String(g.subjectTP || '').trim().toUpperCase();
        const classification = classifyBacklogGrade(g.grade, tp);
        if (classification.isBacklog) {
          list.push({
            code: g.subjectCODE || '',
            name: g.subjectName || '',
            status: classification.displayGrade,
            type: classification.backlogType,
            isExternal: classification.isExternal,
            isInternal: classification.isInternal,
          });
        }
      });
      if (list.length > 0) return list;
    }

    // 3. Fallback parse from backlogSubjects strings: "CODE - NAME (STATUS)" or "CODE (STATUS)"
    if (st.backlogSubjects && st.backlogSubjects.length > 0) {
      return st.backlogSubjects.map((str) => {
        const matchWithDash = str.match(/^([A-Za-z0-9]+)\s*-\s*(.*?)\s*\((.*?)\)$/);
        if (matchWithDash) {
          const rawStatus = matchWithDash[3].trim();
          const classification = classifyBacklogGrade(rawStatus);
          return {
            code: matchWithDash[1].trim(),
            name: matchWithDash[2].trim(),
            status: classification.displayGrade,
            type: classification.backlogType,
            isExternal: classification.isExternal,
            isInternal: classification.isInternal,
          };
        }
        const matchSimple = str.match(/^([A-Za-z0-9]+)\s*\((.*?)\)$/);
        if (matchSimple) {
          const rawStatus = matchSimple[2].trim();
          const classification = classifyBacklogGrade(rawStatus);
          return {
            code: matchSimple[1].trim(),
            name: '',
            status: classification.displayGrade,
            type: classification.backlogType,
            isExternal: classification.isExternal,
            isInternal: classification.isInternal,
          };
        }
        const classification = classifyBacklogGrade(str);
        return {
          code: str,
          name: '',
          status: classification.displayGrade,
          type: classification.backlogType,
          isExternal: classification.isExternal,
          isInternal: classification.isInternal,
        };
      });
    }

    return [];
  };

  // Export Results to CSV with direct F(EX) & F(INT) columns
  const handleExportResultsCsv = () => {
    if (results.length === 0) return;

    let csv =
      "Rank,Registration_No,Student_Name,College,Branch,Semester,SGPA,Total_Credits,Status,Total_Subjects,Passed_Subjects,Total_Backlogs,External_Backlogs_F_EX,Internal_Backlogs_F_INT,Backlog_Details\n";

    sortedFilteredResults.forEach((st, idx) => {
      const cleanName = `"${(st.studentName || '').replace(/"/g, '""')}"`;
      const cleanCollege = `"${(st.collegeName || '').replace(/"/g, '""')}"`;
      const cleanBranch = `"${(st.branchName || '').replace(/"/g, '""')}"`;
      const items = getBacklogItems(st);
      const backlogNotes =
        items.length > 0
          ? `"${items
              .map(
                (b) =>
                  `${b.code}: ${b.name || 'Subject'} [Grade: ${b.status} - ${
                    b.isExternal ? 'External Fail' : b.isInternal ? 'Internal Fail' : 'Special'
                  }]`
              )
              .join('; ')
              .replace(/"/g, '""')}"`
          : `"${(st.backlogSubjects || []).join('; ').replace(/"/g, '""')}"`;

      csv += `${idx + 1},${st.rollNo},${cleanName},${cleanCollege},${cleanBranch},${st.semester},${
        st.sgpa
      },${st.credits},${st.status},${st.totalSubjects},${st.passedSubjects},${st.backlogsCount},${
        st.externalBacklogsCount || 0
      },${st.internalBacklogsCount || 0},${backlogNotes}\n`;
    });

    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.setAttribute('download', `BPUT_Class_Results_${session.replace(/[^a-zA-Z0-9]/g, '_')}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  // Summary Metrics
  const validRecords = results.filter((r) => r.status !== 'NOT_FOUND');
  const passedRecords = results.filter((r) => r.status === 'PASSED');
  const backlogRecords = results.filter((r) => r.status === 'BACKLOG');

  const totalClassExtBacklogs = results.reduce(
    (acc, r) => acc + (r.externalBacklogsCount || 0),
    0
  );
  const totalClassIntBacklogs = results.reduce(
    (acc, r) => acc + (r.internalBacklogsCount || 0),
    0
  );

  const averageSgpa =
    validRecords.length > 0
      ? (validRecords.reduce((acc, curr) => acc + (curr.sgpa || 0), 0) / validRecords.length).toFixed(2)
      : '0.00';

  const topperStudent = [...validRecords].sort((a, b) => (b.sgpa || 0) - (a.sgpa || 0))[0];

  // Filtering & Sorting
  const sortedFilteredResults = results
    .filter((st) => {
      if (filterStatus === 'PASSED' && st.status !== 'PASSED') return false;
      if (filterStatus === 'BACKLOG' && st.status !== 'BACKLOG') return false;
      if (filterStatus === 'NOT_FOUND' && st.status !== 'NOT_FOUND') return false;

      if (searchQuery.trim()) {
        const q = searchQuery.toLowerCase();
        const matchesRoll = st.rollNo.toLowerCase().includes(q);
        const matchesName = st.studentName.toLowerCase().includes(q);
        const matchesBranch = st.branchName.toLowerCase().includes(q);
        return matchesRoll || matchesName || matchesBranch;
      }
      return true;
    })
    .sort((a, b) => {
      if (sortBy === 'SGPA_DESC') return (b.sgpa || 0) - (a.sgpa || 0);
      if (sortBy === 'SGPA_ASC') return (a.sgpa || 0) - (b.sgpa || 0);
      if (sortBy === 'ROLL_ASC') return a.rollNo.localeCompare(b.rollNo);
      if (sortBy === 'NAME_ASC') return a.studentName.localeCompare(b.studentName);
      return 0;
    });

  return (
    <div className="space-y-6 animate-fadeIn">
      {/* Configuration & Input Card */}
      <div className="bg-white rounded-xl border border-slate-200/90 shadow-sm p-4 sm:p-6 no-print">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-4 border-b border-slate-100 gap-2">
          <div>
            <h2 className="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
              <Users className="w-5 h-5 text-sky-700" />
              <span>Bulk Student/ class/ college result checker</span>
            </h2>
            <p className="text-xs text-slate-500 font-medium mt-0.5">
              Accesses each student individually from BPUT and streams results into the class table in real-time
            </p>
          </div>

          <button
            type="button"
            onClick={handleDownloadSampleCsv}
            className="flex items-center gap-1.5 px-3 py-1.5 text-xs text-sky-700 bg-sky-50 hover:bg-sky-100 rounded-lg border border-sky-200 font-medium transition-colors cursor-pointer self-start sm:self-auto"
            title="Download CSV Template"
          >
            <FileSpreadsheet className="w-3.5 h-3.5 text-sky-600" />
            <span>Sample CSV File</span>
          </button>
        </div>

        {/* Session Selector */}
        <div className="mb-5">
          <label className="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Examination Session <span className="text-rose-500">*</span>
          </label>
          <select
            value={session}
            onChange={(e) => setSession(e.target.value)}
            disabled={isProcessing}
            className="w-full sm:w-80 h-11 px-3.5 text-sm font-medium bg-slate-50 hover:bg-white border border-slate-300 rounded-lg shadow-2xs focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition-all text-slate-900 cursor-pointer"
          >
            <option value="default_option">-- Select Examination Session --</option>
            {BPUT_SESSIONS.map((sess) => (
              <option key={sess} value={sess}>
                {sess}
              </option>
            ))}
          </select>
        </div>

        {/* Input Mode Tabs */}
        <div className="flex items-center gap-2 border-b border-slate-200 pb-2 mb-4 text-xs font-semibold">
          <button
            type="button"
            onClick={() => setInputTab('range')}
            className={`px-3.5 py-2 rounded-lg transition-colors cursor-pointer flex items-center gap-1.5 ${
              inputTab === 'range'
                ? 'bg-indigo-600 text-white shadow-2xs font-bold'
                : 'bg-slate-100 text-slate-600 hover:bg-slate-200 font-medium'
            }`}
          >
            <ArrowUpDown className="w-3.5 h-3.5" />
            <span>Registration No Range</span>
          </button>

          <button
            type="button"
            onClick={() => setInputTab('csv')}
            className={`px-3.5 py-2 rounded-lg transition-colors cursor-pointer flex items-center gap-1.5 ${
              inputTab === 'csv'
                ? 'bg-indigo-600 text-white shadow-2xs font-bold'
                : 'bg-slate-100 text-slate-600 hover:bg-slate-200 font-medium'
            }`}
          >
            <Upload className="w-3.5 h-3.5" />
            <span>Upload CSV File</span>
          </button>

          <button
            type="button"
            onClick={() => setInputTab('paste')}
            className={`px-3.5 py-2 rounded-lg transition-colors cursor-pointer flex items-center gap-1.5 ${
              inputTab === 'paste'
                ? 'bg-indigo-600 text-white shadow-2xs font-bold'
                : 'bg-slate-100 text-slate-600 hover:bg-slate-200 font-medium'
            }`}
          >
            <FileText className="w-3.5 h-3.5" />
            <span>Paste Registration Numbers</span>
          </button>
        </div>

        {/* Tab 1: Range Generator (Recommended for classes) */}
        {inputTab === 'range' && (
          <div className="space-y-3">
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label className="block text-xs font-semibold text-slate-700 mb-1">
                  Start Registration No. (e.g. 2001289001)
                </label>
                <input
                  type="text"
                  maxLength={10}
                  value={rangeStart}
                  onChange={(e) => setRangeStart(e.target.value.replace(/\D/g, '').slice(0, 10))}
                  placeholder="2001289001"
                  className="w-full h-11 px-3 text-sm font-mono font-bold bg-slate-50 border border-slate-300 rounded-lg focus:ring-2 focus:ring-sky-500/20"
                />
              </div>

              <div>
                <label className="block text-xs font-semibold text-slate-700 mb-1">
                  End Registration No. (e.g. 2001289015)
                </label>
                <input
                  type="text"
                  maxLength={10}
                  value={rangeEnd}
                  onChange={(e) => setRangeEnd(e.target.value.replace(/\D/g, '').slice(0, 10))}
                  placeholder="2001289015"
                  className="w-full h-11 px-3 text-sm font-mono font-bold bg-slate-50 border border-slate-300 rounded-lg focus:ring-2 focus:ring-sky-500/20"
                />
              </div>
            </div>

            <p className="text-xs text-slate-500">
              💡 Each registration number from start to end will be queried individually in real-time.
            </p>
          </div>
        )}

        {/* Tab 2: CSV Upload */}
        {inputTab === 'csv' && (
          <div className="space-y-3">
            <div
              onClick={() => fileInputRef.current?.click()}
              className="border-2 border-dashed border-slate-300 hover:border-sky-500 rounded-xl p-6 text-center cursor-pointer transition-colors bg-slate-50/50 hover:bg-sky-50/20"
            >
              <input
                ref={fileInputRef}
                type="file"
                accept=".csv,.txt"
                onChange={handleFileUpload}
                className="hidden"
              />
              <Upload className="w-8 h-8 text-slate-400 mx-auto mb-2" />
              <p className="text-sm font-semibold text-slate-700">
                Click to browse or drop CSV/TXT file with student registration numbers
              </p>
              <p className="text-xs text-slate-400 mt-1">
                Supports column headers, comma-separated, or one registration number per line
              </p>
            </div>

            {csvFileName && (
              <div className="flex items-center justify-between p-3 bg-sky-50 rounded-lg border border-sky-200 text-xs">
                <div className="flex items-center gap-2">
                  <FileSpreadsheet className="w-4 h-4 text-sky-700" />
                  <span className="font-semibold text-sky-900">{csvFileName}</span>
                </div>
                <span className="font-mono font-bold text-sky-800">
                  {extractedRolls.length} Registration Numbers Detected
                </span>
              </div>
            )}
          </div>
        )}

        {/* Tab 3: Paste */}
        {inputTab === 'paste' && (
          <div className="space-y-2">
            <label className="block text-xs font-semibold text-slate-700">
              Paste registration numbers (separated by commas, spaces, or lines):
            </label>
            <textarea
              rows={4}
              value={pastedText}
              onChange={(e) => setPastedText(e.target.value)}
              placeholder="e.g. 2001289001, 2001289002, 2001289003..."
              className="w-full p-3 text-xs font-mono bg-slate-50 border border-slate-300 rounded-lg focus:ring-2 focus:ring-sky-500/20"
            />
          </div>
        )}

        {/* Status Message */}
        {statusMessage && (
          <div className="mt-4 p-3 bg-sky-50 text-sky-900 border border-sky-200 rounded-lg text-xs font-medium flex items-center justify-between">
            <span>{statusMessage}</span>
            <button
              onClick={() => setStatusMessage(null)}
              className="text-sky-600 hover:text-sky-900 text-xs px-1"
            >
              ✕
            </button>
          </div>
        )}

        {/* Actions & Live Progress Controls */}
        <div className="mt-5 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
          <div className="flex items-center gap-2.5">
            {!isProcessing ? (
              <button
                type="button"
                onClick={handleStartBulkCheck}
                className="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold text-sm rounded-lg shadow-sm transition-all flex items-center gap-2 cursor-pointer"
              >
                <Play className="w-4 h-4 fill-white text-white" />
                <span>Start Checking Results</span>
              </button>
            ) : (
              <div className="flex items-center gap-2">
                <button
                  type="button"
                  onClick={handleTogglePause}
                  className="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white font-semibold text-xs rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer"
                >
                  {isPaused ? <Play className="w-3.5 h-3.5" /> : <Pause className="w-3.5 h-3.5" />}
                  <span>{isPaused ? 'Resume' : 'Pause'}</span>
                </button>

                <button
                  type="button"
                  onClick={handleStop}
                  className="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer"
                >
                  <StopCircle className="w-3.5 h-3.5" />
                  <span>Stop</span>
                </button>
              </div>
            )}

            {results.length > 0 && !isProcessing && (
              <button
                type="button"
                onClick={() => {
                  setResults([]);
                  setLogs([]);
                  setProgressCount(0);
                }}
                className="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium rounded-lg transition-colors cursor-pointer flex items-center gap-1"
              >
                <RotateCcw className="w-3.5 h-3.5" />
                <span>Clear Table</span>
              </button>
            )}
          </div>

          {/* Active Tracker Pill */}
          {isProcessing && activeRoll && (
            <div className="flex items-center gap-2 px-3 py-1.5 bg-sky-50 border border-sky-300 rounded-lg text-xs font-mono text-sky-900 animate-pulse">
              <Activity className="w-4 h-4 text-sky-600 animate-spin" />
              <span>
                Accessing Reg No: <strong className="text-sky-950 font-bold">{activeRoll}</strong> ({progressCount + 1}/{totalToProcess})
              </span>
            </div>
          )}
        </div>

        {/* Progress Bar */}
        {isProcessing && totalToProcess > 0 && (
          <div className="mt-4 pt-2">
            <div className="flex justify-between text-xs font-mono font-semibold text-slate-700 mb-1">
              <span>Overall Progress:</span>
              <span>
                {progressCount} of {totalToProcess} processed ({Math.round((progressCount / totalToProcess) * 100)}%)
              </span>
            </div>
            <div className="w-full h-3 bg-slate-200 rounded-full overflow-hidden shadow-inner">
              <div
                className="h-full bg-emerald-600 transition-all duration-300"
                style={{ width: `${Math.round((progressCount / totalToProcess) * 100)}%` }}
              />
            </div>
          </div>
        )}
      </div>

      {/* Live Student Data Access Stream Drawer */}
      {logs.length > 0 && (
        <div className="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm no-print animate-fadeIn">
          <div className="px-4 sm:px-5 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between gap-3">
            <div className="flex items-center gap-2.5">
              <div className="w-7 h-7 rounded-lg bg-blue-50 border border-indigo-100 flex items-center justify-center text-blue-600 shrink-0">
                <Activity className="w-4 h-4 text-blue-600 animate-pulse" />
              </div>
              <div className="flex items-center gap-2">
                <span className="font-bold text-slate-900 text-xs sm:text-sm">
                  Live Student Data Access Stream
                </span>
                <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                  <span className="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                  Active Stream
                </span>
              </div>
            </div>

            <div className="flex items-center gap-2.5">
              <span className="text-[11px] text-slate-500 font-mono hidden sm:inline">
                {logs.length} entries
              </span>
              <button
                type="button"
                onClick={() => setShowLiveConsole(!showLiveConsole)}
                className="text-xs font-semibold text-slate-600 hover:text-slate-900 bg-white hover:bg-slate-100 border border-slate-200 px-2.5 py-1 rounded-lg transition-colors cursor-pointer shadow-2xs"
              >
                {showLiveConsole ? 'Hide Stream' : 'Show Stream'}
              </button>
            </div>
          </div>

          {showLiveConsole && (
            <div className="max-h-56 overflow-y-auto divide-y divide-slate-100 bg-white">
              {logs.map((log) => {
                const isPending = log.status === 'PENDING';
                const isSuccess = log.status === 'SUCCESS';
                const isBacklog = log.status === 'BACKLOG';
                const isNotFound = log.status === 'NOT_FOUND';

                return (
                  <div
                    key={log.id}
                    className="px-4 py-2.5 flex flex-wrap items-center justify-between gap-2 text-xs hover:bg-slate-50/70 transition-colors"
                  >
                    <div className="flex items-center gap-2.5 flex-wrap min-w-0">
                      <span className="text-[11px] font-mono text-slate-400">[{log.timestamp}]</span>
                      <span className="font-mono font-bold text-slate-900 bg-slate-100 px-1.5 py-0.5 rounded text-[11px] border border-slate-200">
                        {log.rollNo}
                      </span>
                      {log.name && (
                        <span className="font-semibold text-slate-800 truncate max-w-xs text-xs">
                          {log.name}
                        </span>
                      )}
                    </div>

                    <div>
                      {isPending ? (
                        <span className="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-blue-50 text-blue-700 border border-blue-200 animate-pulse">
                          <Activity className="w-3 h-3 text-blue-600 animate-spin" />
                          <span>Querying BPUT Gateway...</span>
                        </span>
                      ) : isSuccess ? (
                        <span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                          <CheckCircle2 className="w-3 h-3 text-emerald-600" />
                          <span>All Clear • SGPA: {log.sgpa?.toFixed(2)}</span>
                        </span>
                      ) : isBacklog ? (
                        <span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-50 text-rose-800 border border-rose-200">
                          <AlertTriangle className="w-3 h-3 text-rose-600" />
                          <span>{log.message}</span>
                        </span>
                      ) : isNotFound ? (
                        <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-600 border border-slate-200">
                          Record Not Published
                        </span>
                      ) : (
                        <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-rose-50 text-rose-700 border border-rose-200">
                          {log.message}
                        </span>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      )}

      {/* Real-time Results Dashboard & Table */}
      {results.length > 0 && (
        <div className="space-y-4">
          {/* Top Metric Cards */}
          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 print:grid-cols-5 print:gap-2 print:mb-3">
            <div className="bg-white p-3.5 rounded-xl border border-slate-200 shadow-2xs">
              <span className="text-[10px] text-slate-500 font-bold uppercase tracking-wider block">
                Total Loaded
              </span>
              <span className="text-2xl font-black text-slate-900 font-mono">
                {results.length}
              </span>
              <span className="text-[11px] text-slate-400 block mt-0.5">Students accessed</span>
            </div>

            <div className="bg-white p-3.5 rounded-xl border border-emerald-200 shadow-2xs">
              <span className="text-[10px] text-emerald-700 font-bold uppercase tracking-wider block">
                All Clear (Passed)
              </span>
              <span className="text-2xl font-black text-emerald-800 font-mono">
                {passedRecords.length}
              </span>
              <span className="text-[11px] text-emerald-600 block mt-0.5">
                {validRecords.length > 0
                  ? `${Math.round((passedRecords.length / validRecords.length) * 100)}% Pass Rate`
                  : '0%'}
              </span>
            </div>

            <div className="bg-white p-3.5 rounded-xl border border-rose-200 shadow-2xs">
              <div className="flex items-center justify-between">
                <span className="text-[10px] text-rose-700 font-bold uppercase tracking-wider block">
                  With Backlogs
                </span>
                <span className="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-rose-100 text-rose-800">
                  Strict Count
                </span>
              </div>
              <span className="text-2xl font-black text-rose-800 font-mono">
                {backlogRecords.length}
              </span>
              <div className="flex items-center gap-1.5 mt-0.5 text-[10px] font-mono flex-wrap">
                <span className="text-rose-700 font-bold bg-rose-50 px-1.5 py-0.5 rounded border border-rose-200">
                  {totalClassExtBacklogs} F(EX)
                </span>
                <span className="text-amber-800 font-bold bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200">
                  {totalClassIntBacklogs} F(INT)
                </span>
              </div>
            </div>

            <div className="bg-white p-3.5 rounded-xl border border-sky-200 shadow-2xs">
              <span className="text-[10px] text-sky-700 font-bold uppercase tracking-wider block">
                Class Mean SGPA
              </span>
              <span className="text-2xl font-black text-sky-900 font-mono">
                {averageSgpa}
              </span>
              <span className="text-[11px] text-sky-600 block mt-0.5">Average score</span>
            </div>

            <div className="bg-white p-3.5 rounded-xl border border-amber-200 shadow-2xs col-span-2 sm:col-span-1">
              <span className="text-[10px] text-amber-800 font-bold uppercase tracking-wider block flex items-center gap-1">
                <Award className="w-3.5 h-3.5 text-amber-600" />
                Class Topper
              </span>
              <span className="text-2xl font-black text-amber-900 font-mono">
                {topperStudent ? topperStudent.sgpa.toFixed(2) : '0.00'}
              </span>
              <span className="text-[10px] text-slate-600 truncate block mt-0.5" title={topperStudent?.studentName}>
                {topperStudent ? topperStudent.studentName : 'No records'}
              </span>
            </div>
          </div>

          {/* Table Container */}
          <div className="bg-white rounded-xl border border-slate-200/90 shadow-sm overflow-hidden">
            {/* Table Control Bar */}
            <div className="p-4 border-b border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-3 no-print">
              {/* Search & Filter */}
              <div className="flex flex-wrap items-center gap-2.5">
                <div className="relative w-full sm:w-64">
                  <input
                    type="text"
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                    placeholder="Search by name, roll no, branch..."
                    className="w-full h-9 pl-8 pr-3 text-xs bg-slate-50 border border-slate-300 rounded-lg focus:ring-2 focus:ring-sky-500/20"
                  />
                  <Search className="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-3 pointer-events-none" />
                </div>

                <div className="flex items-center gap-1 bg-slate-100 p-1 rounded-lg text-xs">
                  <button
                    onClick={() => setFilterStatus('ALL')}
                    className={`px-2.5 py-1 rounded-md transition-colors cursor-pointer ${
                      filterStatus === 'ALL' ? 'bg-white font-bold text-slate-900 shadow-2xs' : 'text-slate-600'
                    }`}
                  >
                    All ({results.length})
                  </button>
                  <button
                    onClick={() => setFilterStatus('PASSED')}
                    className={`px-2.5 py-1 rounded-md transition-colors cursor-pointer ${
                      filterStatus === 'PASSED' ? 'bg-white font-bold text-emerald-700 shadow-2xs' : 'text-slate-600'
                    }`}
                  >
                    Pass ({passedRecords.length})
                  </button>
                  <button
                    onClick={() => setFilterStatus('BACKLOG')}
                    className={`px-2.5 py-1 rounded-md transition-colors cursor-pointer ${
                      filterStatus === 'BACKLOG' ? 'bg-white font-bold text-rose-700 shadow-2xs' : 'text-slate-600'
                    }`}
                  >
                    Backlog ({backlogRecords.length})
                  </button>
                </div>
              </div>

              {/* Sorting and Exports */}
              <div className="flex items-center flex-wrap gap-2">
                <select
                  value={sortBy}
                  onChange={(e: any) => setSortBy(e.target.value)}
                  className="h-9 px-2.5 text-xs bg-slate-50 border border-slate-300 rounded-lg text-slate-700 cursor-pointer"
                >
                  <option value="SGPA_DESC">Sort: SGPA (Highest First)</option>
                  <option value="SGPA_ASC">Sort: SGPA (Lowest First)</option>
                  <option value="ROLL_ASC">Sort: Registration No.</option>
                  <option value="NAME_ASC">Sort: Student Name</option>
                </select>

                <button
                  type="button"
                  onClick={handleExportResultsCsv}
                  className="flex items-center gap-1.5 px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-semibold shadow-2xs transition-colors cursor-pointer"
                  title="Export results table to CSV"
                >
                  <Download className="w-3.5 h-3.5" />
                  <span>Export CSV</span>
                </button>

                <button
                  type="button"
                  onClick={handleGenerateBulkPdf}
                  disabled={isExportingPdf}
                  className="flex items-center gap-1.5 px-3 py-1.5 bg-blue-700 hover:bg-blue-800 text-white rounded-lg text-xs font-semibold shadow-2xs transition-colors cursor-pointer disabled:opacity-75"
                  title="Generate official vector PDF class report"
                >
                  <FileText className="w-3.5 h-3.5" />
                  <span>{isExportingPdf ? 'Generating PDF...' : bulkPdfDownloaded ? 'PDF Saved' : 'Download PDF'}</span>
                </button>

                <button
                  type="button"
                  onClick={handlePrintBulk}
                  className="flex items-center gap-1.5 px-3 py-1.5 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-xs font-semibold shadow-2xs transition-colors cursor-pointer"
                  title="Print Class Summary and download PDF"
                >
                  <Printer className="w-3.5 h-3.5" />
                  <span>Print Result</span>
                </button>
              </div>
            </div>

            {/* Live Table */}
            <div className="overflow-x-auto">
              <table className="w-full text-left text-xs text-slate-800 border-collapse">
                <thead className="bg-slate-900 text-white uppercase text-[11px] font-bold tracking-wider">
                  <tr>
                    <th className="py-3 px-3 w-12 text-center border-r border-slate-700">Rank</th>
                    <th className="py-3 px-3 w-32 border-r border-slate-700">Reg No.</th>
                    <th className="py-3 px-4 border-r border-slate-700">Student Name</th>
                    <th className="py-3 px-4 border-r border-slate-700">Branch &amp; College</th>
                    <th className="py-3 px-3 w-20 text-center border-r border-slate-700">SGPA</th>
                    <th className="py-3 px-3 w-20 text-center border-r border-slate-700">Credits</th>
                    <th className="py-3 px-4 border-r border-slate-700">Status</th>
                    <th className="py-3 px-3 w-24 text-center no-print">Action</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-200">
                  {sortedFilteredResults.map((st, idx) => {
                    const isTopper = idx === 0 && st.sgpa > 0 && sortBy === 'SGPA_DESC';
                    const hasBacklog = st.status === 'BACKLOG';

                    return (
                      <tr
                        key={`${st.rollNo}-${idx}`}
                        className={`transition-colors ${
                          isTopper
                            ? 'bg-amber-50/50 font-medium'
                            : hasBacklog
                            ? 'bg-rose-50/20'
                            : idx % 2 === 0
                            ? 'bg-white'
                            : 'bg-slate-50/40'
                        } hover:bg-sky-50/60`}
                      >
                        <td className="py-2.5 px-3 text-center border-r border-slate-200 font-mono text-slate-500 font-bold">
                          {isTopper ? '🥇 1' : idx + 1}
                        </td>
                        <td className="py-2.5 px-3 border-r border-slate-200 font-mono font-bold text-slate-900">
                          {st.rollNo}
                        </td>
                        <td className="py-2.5 px-4 border-r border-slate-200 font-semibold text-slate-900">
                          {st.studentName}
                        </td>
                        <td className="py-2.5 px-4 border-r border-slate-200 text-slate-600">
                          <span className="block font-medium text-slate-800">{st.branchName}</span>
                          <span className="block text-[10px] text-slate-400 truncate max-w-xs">
                            {st.collegeName}
                          </span>
                        </td>
                        <td className="py-2.5 px-3 text-center border-r border-slate-200 font-mono font-black text-sm">
                          {st.sgpa > 0 ? (
                            <span className="text-sky-900">{st.sgpa.toFixed(2)}</span>
                          ) : (
                            <span className="text-slate-400">0.00</span>
                          )}
                        </td>
                        <td className="py-2.5 px-3 text-center border-r border-slate-200 font-mono text-slate-700">
                          {st.credits}
                        </td>
                        <td className="py-2.5 px-4 border-r border-slate-200">
                          {st.status === 'PASSED' ? (
                            <span className="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 shadow-2xs">
                              <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                              All Clear
                            </span>
                          ) : st.status === 'BACKLOG' ? (
                            <div className="space-y-1.5 py-0.5">
                              {/* Strict Breakdown Badges */}
                              <div className="flex items-center gap-1.5 flex-wrap">
                                <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-black bg-rose-100 text-rose-900 border border-rose-300">
                                  <AlertTriangle className="w-3.5 h-3.5 text-rose-600 shrink-0" />
                                  {st.backlogsCount} Backlog{st.backlogsCount > 1 ? 's' : ''}
                                </span>
                                {(st.externalBacklogsCount || 0) > 0 && (
                                  <span
                                    className="px-1.5 py-0.5 rounded text-[10px] font-mono font-black bg-red-100 text-red-800 border border-red-300"
                                    title="External Exam Failures"
                                  >
                                    {st.externalBacklogsCount} F(EX)
                                  </span>
                                )}
                                {(st.internalBacklogsCount || 0) > 0 && (
                                  <span
                                    className="px-1.5 py-0.5 rounded text-[10px] font-mono font-black bg-amber-100 text-amber-900 border border-amber-300"
                                    title="Internal Assessment / Sessional Failures"
                                  >
                                    {st.internalBacklogsCount} F(INT)
                                  </span>
                                )}
                              </div>

                              {/* Direct Subject Badges: F(EX) / F(INT) */}
                              <div className="space-y-1">
                                {getBacklogItems(st).map((b, bIdx) => {
                                  const isExt = b.isExternal || b.status.includes('EX') || b.status.includes('ABS');
                                  const isInt = b.isInternal || b.status.includes('INT');
                                  const isBoth = b.type === 'BOTH' || b.status.includes('INT+EX');

                                  return (
                                    <div
                                      key={bIdx}
                                      className={`p-1.5 rounded-md border text-[11px] leading-tight space-y-0.5 ${
                                        isBoth
                                          ? 'bg-purple-50/90 border-purple-200'
                                          : isInt
                                          ? 'bg-amber-50/90 border-amber-200'
                                          : 'bg-rose-50/90 border-rose-200'
                                      }`}
                                    >
                                      <div className="flex items-center justify-between gap-1.5">
                                        <span className="font-mono font-bold text-slate-900 bg-white px-1.5 py-0.5 rounded border border-slate-200 shadow-2xs text-[10px]">
                                          {b.code}
                                        </span>
                                        <span
                                          className={`inline-flex items-center px-1.5 py-0.5 rounded font-mono font-black text-[10px] shadow-2xs ${
                                            isBoth
                                              ? 'bg-purple-700 text-white'
                                              : isInt
                                              ? 'bg-amber-600 text-white'
                                              : 'bg-red-600 text-white'
                                          }`}
                                          title={
                                            isBoth
                                              ? 'Failed both Internal Assessment & External Exam'
                                              : isInt
                                              ? 'Internal Assessment / Sessional Fail'
                                              : 'External University Examination Fail'
                                          }
                                        >
                                          {b.status}
                                        </span>
                                      </div>
                                      {b.name ? (
                                        <p
                                          className="font-semibold text-slate-800 text-[11px] leading-snug line-clamp-2"
                                          title={b.name}
                                        >
                                          {b.name}
                                        </p>
                                      ) : null}
                                    </div>
                                  );
                                })}
                              </div>
                            </div>
                          ) : (
                            <span className="text-slate-400 text-[11px]">Record Not Published</span>
                          )}
                        </td>
                        <td className="py-2.5 px-3 text-center no-print">
                          {st.status !== 'NOT_FOUND' && (
                            <button
                              type="button"
                              onClick={() => onViewStudentMarks(st.rollNo, st.semId, session)}
                              className="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white rounded transition-colors cursor-pointer"
                              title="View detailed subject marksheet"
                            >
                              <Eye className="w-3.5 h-3.5" />
                              <span>Marks</span>
                            </button>
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            {/* Official Printable Report Footer */}
            <div className="hidden print-only p-4 border-t-2 border-slate-800 text-xs text-slate-800 print-page-break">
              <div className="flex justify-between items-end">
                <div>
                  <p className="font-bold uppercase tracking-wider text-black">
                    Class / College Academic Evaluation Summary
                  </p>
                  <p className="text-[10px] text-slate-600 mt-0.5">
                    Total Evaluated: {results.length} | Cleared: {passedRecords.length} | Backlogs: {backlogRecords.length} | Mean SGPA: {averageSgpa}
                  </p>
                  <p className="text-[9px] text-slate-500 mt-1">
                    Computer Generated Record • University Results Gateway
                  </p>
                </div>
                <div className="text-right">
                  <div className="h-10"></div>
                  <p className="font-bold uppercase tracking-wider text-slate-900 border-t border-slate-800 pt-1">
                    Head of Department / Examination Cell
                  </p>
                  <p className="text-[10px] text-slate-600">Verification &amp; Record Signature</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};
